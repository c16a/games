{
  "name": "games",
  "module": "index.ts",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --hot ./index.ts",
    "clean:dist": "bun run ./scripts/clean-dist.ts",
    "build": "bun run clean:dist && bunx tsc --noEmit && bun build ./index.html --outdir=dist --minify --target=browser --splitting --metafile=.build/bundle-meta.json && bun run ./scripts/copy-chess-assets.ts",
    "perf:audit": "bun run ./scripts/performance-audit.ts",
    "start": "bun ./index.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "chess.js": "1.4.0",
    "kaplay": "^3001.0.19",
    "stockfish": "18.0.8"
  }
}
